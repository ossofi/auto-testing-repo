{
  "name": "auto-testing-repo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "mocha --reporter mochawesome --reporter-options reportDir=reports,reportFilename=test-report,html=true",
    "coverage": "c8 mocha",
    "lint": "eslint src test --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --fix",
    "build": "babel src --out-dir dist",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.js": "npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ossofi/auto-testing-repo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "c8": "^10.1.3",
    "chai": "^5.2.0",
    "eslint": "^9.26.0",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "mocha": "^11.1.0",
    "mochawesome": "^7.1.3"
  }
}
